# --- 1. 数据加载 ---
# 请确保 PEMS04.npz 文件在当前工作目录下，或者提供完整路径
file_path = "./PEMS04.npz"

try:
    data = np.load(file_path)
    traffic_data = data['data']
    print(f"成功加载 PEMS04.npz 文件。交通数据形状: {traffic_data.shape}")
    print(f"数据包含 {traffic_data.shape[0]} 个时间步，{traffic_data.shape[1]} 个传感器，{traffic_data.shape[2]} 种特征。")
except FileNotFoundError:
    print(f"错误：文件 '{file_path}' 未找到。请确保文件路径正确。")
    print("正在生成模拟数据进行演示...")
    # 如果文件未找到，生成模拟数据用于演示
    num_timesteps = 1000  # 模拟更多时间步
    num_sensors = 307
    num_features = 3
    # 模拟数据：使用正弦波加随机噪声来模拟交通流量的周期性
    traffic_data = np.zeros((num_timesteps, num_sensors, num_features))
    for i in range(num_sensors):
        base_flow = 50 + 40 * np.sin(np.linspace(0, 2 * np.pi * num_timesteps / (288 * 1.5), num_timesteps))
        # 加上传感器特有的波动和随机噪声
        traffic_data[:, i, 0] = np.maximum(0, base_flow + np.random.randn(num_timesteps) * 10 + i * 0.1)
        # 模拟速度和占有率（其他特征，这里简化）
        traffic_data[:, i, 1] = np.maximum(10, 60 - traffic_data[:, i, 0] * 0.5 + np.random.randn(num_timesteps) * 5)
        traffic_data[:, i, 2] = np.maximum(0, traffic_data[:, i, 0] * 0.1 + np.random.randn(num_timesteps) * 2)
    print(f"已使用模拟数据。交通数据形状: {traffic_data.shape}")


# -------------------------------
# 2. 参数设置
# -------------------------------
chunk_size_i = 5  # 每组 5 个传感器
chunk_size_t = 288  # 每组 288 个时间步（= 24小时 / 5分钟 = 288）
num_sensors = 307
num_time_steps = 16992  # 59天 × 288 = 16992
# 起始时间：2018-01-01 00:00
start_base_time = datetime(2018, 1, 1)
# 计算可支持的组数
max_groups = num_time_steps // chunk_size_t  # 16992 // 288 = 59
num_groups = min((num_sensors + chunk_size_i - 1) // chunk_size_i, max_groups)
print(f"数据时间范围：2018-01-01 至 2018-02-28（共59天）")
print(f"每5分钟一个数据点 → 每天 288 个时间步")
print(f"支持 {max_groups} 个时间块 → 最多处理 {num_groups * chunk_size_i} = {num_groups * 5} 个传感器")
print(f"将处理传感器 0 ~ {num_groups * 5 - 1}，其余 {307 - num_groups * 5} 个将被忽略")
# -------------------------------
# 3. 构建数据列表
# -------------------------------
rows = []
for group_idx in range(num_groups):
    # 当前传感器范围
    sensor_start = group_idx * chunk_size_i
    sensor_end = min(sensor_start + chunk_size_i, num_sensors)
    # 当前时间窗口（原始数据中的时间索引）
    time_start = group_idx * chunk_size_t
    time_end = time_start + chunk_size_t
    # 提取数据块: (288, num_sensors_in_group, 3)
    block = data[time_start:time_end, sensor_start:sensor_end, :]  # shape (288, <=5, 3)
    # 当前组对应的真实起始时间
    group_start_time = start_base_time + timedelta(days=group_idx)
    # 遍历每个传感器
    for local_s in range(block.shape[1]):
        s = sensor_start + local_s  # 全局传感器 ID
        sensor_data = block[:, local_s, :]  # (288, 3)
        # 遍历每个时间步（0 ~ 287）
        for t in range(chunk_size_t):
            # 计算真实时间戳
            current_time = group_start_time + timedelta(minutes=5 * t)  # 每步5分钟
            timestamp_str = current_time.strftime('%Y-%m-%d %H:%M')  # 精确到分钟

            rows.append([
                s,
                sensor_data[t, 0],  # flow
                sensor_data[t, 1],  # speed
                sensor_data[t, 2],  # occupancy
                timestamp_str
            ])
# -------------------------------
# 4. 转为 DataFrame 并保存
# -------------------------------
df = pd.DataFrame(rows, columns=['sensor_id', 'flow', 'speed', 'occupancy', 'datetime'])
# 按 sensor_id 和 时间排序
