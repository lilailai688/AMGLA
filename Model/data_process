trend_array_norm = (trend_array - trend_array.min()) / (trend_array.max() - trend_array.min())  # shape = (N,)
cols_to_perturb = ['speed', 'occupancy', 'OT']
def add_instable_trend_noise(group):
    n = len(group)
    # 如果分组长度与趋势曲线不等，用插值映射过去
    x_src = np.linspace(0, 1, len(trend_array_norm))
    x_dst = np.linspace(0, 1, n)
    # 插值得到分组长度的趋势系数
    factors = np.interp(x_dst, x_src, trend_array_norm)
    # 叠加高波动性随机噪声
    for col in cols_to_perturb:
        # 此处调噪声系数，加大不稳定性
        group[col] = group[col].values + factors * np.random.randn(n) * 300 + factors * 400  # 100是趋势增幅可调
    return group

